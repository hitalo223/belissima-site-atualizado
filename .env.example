# Melhor Envio: use sandbox até validar todo o fluxo.
MELHOR_ENVIO_ENV=sandbox
MELHOR_ENVIO_ACCESS_TOKEN=
MELHOR_ENVIO_USER_AGENT=Belissima Moda Intima (email-de-suporte@dominio.com.br)
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_REDIRECT_URI=https://seu-dominio.com.br/api/shipping-oauth-callback
SHIPPING_TOKEN_ENCRYPTION_KEY=
SHIPPING_OAUTH_STATE_SECRET=

# CEP real da expedição em Pontal/SP, somente números.
SHIPPING_ORIGIN_POSTAL_CODE=
SHIPPING_ENABLED=false

# R$ 199,00 em centavos.
FREE_SHIPPING_THRESHOLD_CENTS=19900
